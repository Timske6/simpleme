{
	"schemaVersion": 1,
	"id": "simpleme",
	"version": "${version}",
	"name": "Simple ME Terminal",
	"description": "A simple quality-of-life storage terminal: one block that stores everything, shows all items and lets you craft directly from storage.",
	"authors": ["Timske6"],
	"contact": {
		"homepage": "https://github.com/Timske6/simpleme",
		"sources": "https://github.com/Timske6/simpleme",
		"issues": "https://github.com/Timske6/simpleme/issues"
	},
	"license": "MIT",
	"icon": "assets/simpleme/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": ["io.github.timske6.simpleme.SimpleME"],
		"client": ["io.github.timske6.simpleme.client.SimpleMEClient"]
	},
	"mixins": ["simpleme.mixins.json"],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": ">=0.161.0"
	}
}
